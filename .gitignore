# Streamlit
.streamlit/secrets.toml

# Wardrobe Builder runtime artifacts
# Per-user images saved by save_user_item(). Ephemeral on Streamlit Cloud;
# kept out of version control so the repo doesn't bloat with user uploads.
wardrobe_images/

# ──────────────────────────────────────────────────────────────────────
# Per-user state files (written by the running app, never committed)
# ──────────────────────────────────────────────────────────────────────
# Tracking these would mean every push rebuilds the Streamlit Cloud
# container from git and OVERWRITES the user's imported calendar
# events / added wardrobe items / fit profile / wishlist / routine.
# It would also leak real personal data (calendar event titles,
# addresses, body measurements) into a public repo.
#
# Default seed/demo data lives in seed_*.json files; the running app
# falls back to those when no user overlay exists.
calendar_events.json
calendar_subscription.json
user_profile.json
user_wardrobe.json
wear_history.json
routine.json
wishlist.json
favorite_stores.json
stores.json

# MkDocs build artifacts — the staging directory populated by
# scripts/stage_docs.py and the built static site MkDocs emits.
_docs_build/
site/

# Environment variables
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log


# Local backups (created by manual operations like data restoration or anonymization)
.data-backups/
.anonymization-backups/

# Local-only knowledge-graph overlay (generated by the Wardrobe page's
# "Regenerate from my data" button — includes the user's real wardrobe
# and wear history; never committed). The public-seed snapshot at
# graph/wearly-knowledge-graph.json IS committed.
graph/wearly-knowledge-graph.user.json

# Node deps for the press-kit deck generator (PPTX-build tooling).
# The deck itself + its source live alongside, but the npm install is
# huge and noisy — rebuild on demand with `npm install` inside press-kit/.
press-kit/node_modules/
press-kit/package-lock.json
# Local PDF previews of the deck (regenerable from PPTX in PowerPoint).
press-kit/*.pdf
press-kit/screenshots/
